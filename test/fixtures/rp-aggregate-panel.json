{
  "language": "rp/1",
  "target": 9,
  "name": "面板内独立数据实例",
  "domain": "web",
  "theme": "enterprise-light",
  "models": {
    "Item": {
      "id": "text",
      "title": "text",
      "qty": "number"
    }
  },
  "datasets": {
    "items": {
      "model": "Item",
      "rows": [
        {
          "id": "seed",
          "title": "Initial row",
          "qty": 2
        }
      ]
    }
  },
  "pages": [
    {
      "id": "panelData",
      "name": "面板数据",
      "canvas": {
        "w": 900,
        "h": 550
      },
      "root": {
        "type": "box",
        "id": "root",
        "layout": "column",
        "padding": 24,
        "gap": 16,
        "children": [
          {
            "type": "label",
            "id": "heading",
            "text": "=concat(text(var.left_sum), \"/\", text(var.right_sum), \";\", text(var.left_count), \"/\", text(var.right_count))",
            "w": "fill",
            "h": 28
          },
          {
            "type": "dynamic-panel",
            "id": "outer",
            "w": 850,
            "h": 420,
            "states": [
              {
                "id": "editing",
                "root": {
                  "type": "box",
                  "id": "content",
                  "layout": "column",
                  "gap": 16,
                  "padding": 12,
                  "children": [
                    {
                      "type": "box",
                      "id": "lists",
                      "layout": "row",
                      "gap": 20,
                      "h": 120,
                      "children": [
                        {
                          "type": "repeater",
                          "id": "left",
                          "dataset": "items",
                          "key": "id",
                          "w": 390,
                          "h": 120,
                          "rowHeight": 40,
                          "template": {
                            "type": "label",
                            "id": "title",
                            "text": {
                              "item": "title"
                            },
                            "w": "fill",
                            "h": 28
                          }
                        },
                        {
                          "type": "repeater",
                          "id": "right",
                          "dataset": "items",
                          "key": "id",
                          "w": 390,
                          "h": 120,
                          "rowHeight": 40,
                          "template": {
                            "type": "label",
                            "id": "title",
                            "text": {
                              "item": "title"
                            },
                            "w": "fill",
                            "h": 28
                          }
                        }
                      ]
                    },
                    {
                      "type": "box",
                      "id": "actions",
                      "layout": "row",
                      "gap": 20,
                      "children": [
                        {
                          "type": "button",
                          "id": "addLeft",
                          "text": "只添加左侧",
                          "w": 190,
                          "on": {
                            "click": [
                              {
                                "type": "data-add",
                                "target": {
                                  "ref": "left"
                                },
                                "rows": [
                                  {
                                    "id": "left",
                                    "title": "左侧独立记录",
                                    "qty": 3
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "type": "button",
                          "id": "addRight",
                          "text": "只添加右侧",
                          "w": 190,
                          "on": {
                            "click": [
                              {
                                "type": "data-add",
                                "target": {
                                  "ref": "right"
                                },
                                "rows": [
                                  {
                                    "id": "right",
                                    "title": "右侧独立记录",
                                    "qty": 3
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "button",
                      "id": "leave",
                      "text": "离开当前状态",
                      "w": 190,
                      "on": {
                        "click": [
                          {
                            "type": "set-panel-state",
                            "target": {
                              "ref": "outer"
                            },
                            "state": "summary"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "id": "summary",
                "root": {
                  "type": "box",
                  "id": "summaryContent",
                  "layout": "column",
                  "gap": 16,
                  "children": [
                    {
                      "type": "label",
                      "id": "summaryText",
                      "text": "返回后保留两个列表各自的数据",
                      "w": "fill",
                      "h": 28
                    },
                    {
                      "type": "button",
                      "id": "back",
                      "text": "返回列表",
                      "w": 190,
                      "on": {
                        "click": [
                          {
                            "type": "set-panel-state",
                            "target": {
                              "ref": "outer"
                            },
                            "state": "editing"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "computed": {
    "left_count": {
      "type": "number",
      "compute": {
        "op": "count",
        "target": "left",
        "scope": "dataset"
      }
    },
    "right_count": {
      "type": "number",
      "compute": {
        "op": "count",
        "target": "right",
        "scope": "dataset"
      }
    },
    "left_sum": {
      "type": "number",
      "compute": {
        "op": "sum",
        "target": "left",
        "scope": "dataset",
        "field": "qty"
      }
    },
    "right_sum": {
      "type": "number",
      "compute": {
        "op": "sum",
        "target": "right",
        "scope": "dataset",
        "field": "qty"
      }
    }
  }
}