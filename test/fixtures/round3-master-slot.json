{"language": "rp/1", "target": 9, "theme": "mobile-hifi", "domain": "mobile", "device": "iphone-17", "adaptiveViews": [{"id": "mob", "name": "Mobile 390", "width": 390, "condition": "<="}, {"id": "desk", "name": "Desktop 1280", "width": 1280, "condition": ">="}], "variables": {"sel": {"type": "text", "value": "a"}, "done": {"type": "number", "value": 2}}, "models": {"T": {"id": "text", "title": "text", "qty": "number"}}, "datasets": {"rows": {"model": "T", "rows": [{"id": "a", "title": "Alpha", "qty": 2}, {"id": "b", "title": "Beta", "qty": 3}]}}, "computed": {"total": {"op": "sum", "dataset": "rows", "field": "=item.qty"}}, "views": {"DV": {"source": "rows", "key": "id", "selector": "$sel", "fields": {"det_t": "title", "det_q": "qty"}}}, "pages": [{"id": "list", "master": "shell_m", "slot": {"body": [{"type": "repeater", "id": "rep", "dataset": "rows", "key": "id", "w": "fill", "h": 180, "rowHeight": 44, "template": {"type": "box", "id": "row", "layout": "row", "w": "fill", "h": 44, "children": [{"type": "label", "id": "rt", "text": {"item": "title"}, "w": "fill", "h": 18}, {"type": "button", "id": "pick", "text": "选", "w": 56, "h": 32, "fontSize": 11, "onClick": [{"set": {"$sel": {"item": "id"}}}, {"goto": "detail"}]}]}}, {"type": "label", "id": "sum", "text": "=text(var.total)", "w": "fill", "h": 20}]}}, {"id": "detail", "master": "shell_m", "slot": {"body": [{"type": "label", "id": "det_t", "text": "?", "w": "fill", "h": 28, "adaptive": {"mob": {"w": 300}, "desk": {"w": 900}}}, {"type": "label", "id": "det_q", "text": "?", "w": "fill", "h": 20}]}}], "masters": {"shell_m": {"name": "应用外壳", "layout": [{"type": "phone-shell", "id": "ms", "title": "星选", "children": [{"type": "box", "id": "body", "layout": "column", "w": "fill", "h": "fill", "gap": 12}]}]}}}