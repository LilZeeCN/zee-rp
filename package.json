{
  "name": "zee-rp",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Screenshot reconstruction, RP/1 compilation, and native Axure RP tooling",
  "bin": {
    "zee-rp": "./bin/axure.mjs",
    "zee-rp-mcp": "./bin/mcp.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/regression.mjs",
    "test:native": "node test/native-check.mjs",
    "test:parity": "node test/parity-check.mjs",
    "test:mcp": "node test/mcp-check.mjs",
    "test:historical": "node test/research-regression.mjs",
    "test:historical-mcp": "node test/research-mcp-check.mjs",
    "test:jobs": "node test/jobs-check.mjs",
    "mcp": "node bin/mcp.mjs",
    "test:language": "python3 test/rp-language-check.py",
    "test:sync": "python3 -B test/rp1-merge-residual-check.py",
    "test:runtime": "python3 test/rp-runtime-check.py && python3 test/rp-aggregate-check.py && node test/runtime-native-check.mjs",
    "test:trace": "node scripts/trace.mjs selftest",
    "test:backend": "node test/native-backend-check.mjs",
    "test:visual": "node test/native-visual-check.mjs",
    "test:acceptance": "python3 test/rp-acceptance-check.py && node test/native-acceptance-check.mjs",
    "test:architecture": "python3 test/rp-architecture-upgrades-check.py && python3 test/rp-audit-gaps-check.py && node test/rp-audit-native-check.mjs",
    "pack:source": "node scripts/pack-release.mjs",
    "test:scopes": "node test/scoped-interactions-check.mjs",
    "test:mcp-generate": "node test/mcp-generate-check.mjs",
    "test:authoring": "node test/authoring-workflow-check.mjs",
    "bench:authoring": "node test/authoring-benchmark.mjs",
    "test:trace-recovery": "python3 -B test/trace-recovery-check.py",
    "test:quality": "python3 -B test/creation-quality-check.py && node test/creation-quality-check.mjs",
    "test:report": "python3 -B test/report-regressions-check.py && node test/report-mcp-check.mjs",
    "test:report-round3": "node test/report-round3-check.mjs",
    "test:styles": "node test/custom-styles-check.mjs",
    "test:polish": "python3 -B test/visual-polish-check.py",
    "studio": "node studio/cli.mjs start",
    "test:studio-repairs": "node --test test/studio-audit-repairs-check.mjs",
    "test:studio-design": "node --test test/studio-design-check.mjs test/studio-design-workflow-check.mjs",
    "test:studio-multi": "node --test test/studio-compact-multi-check.mjs",
    "test:studio-metrics": "node --test test/studio-design-metrics-check.mjs",
    "test:macro-lift": "node --test test/rp1-macro-lift-check.mjs",
    "test:studio-explore": "node --test test/studio-explore-check.mjs",
    "test:studio-anchors": "node --test test/studio-anchors-check.mjs",
    "test:repeater-where": "node --test test/rp1-repeater-where-check.mjs",
    "test:studio-consistency": "node --test test/studio-consistency-check.mjs",
    "test:studio-fix-plan": "node --test test/studio-fix-plan-check.mjs",
    "test:studio-content": "node --test test/studio-content-plan-check.mjs",
    "test:studio-anti-gaming": "node test/studio-anti-gaming-check.mjs",
    "test:studio-pixels": "node --test test/studio-pixel-contrast-check.mjs",
    "test:studio-editing": "node --test --test-concurrency=1 test/studio-editing-check.mjs test/studio-gesture-browser-check.mjs test/studio-clipboard-browser-check.mjs test/studio-layout-check.mjs",
    "test:studio-ceiling": "node --test test/studio-ceiling-check.mjs",
    "test:studio-ai": "node --test --test-concurrency=1 test/studio-reliability-check.mjs test/studio-authoring-query-check.mjs test/studio-design-guidance-check.mjs test/studio-rp1-authoring-check.mjs test/studio-rp1-unified-and-forms-check.mjs test/studio-trial-regressions-check.mjs test/studio-phase-decisions-check.mjs test/studio-contracts-check.mjs test/studio-command-ref-check.mjs test/studio-command-sweep-check.mjs test/studio-versions-check.mjs test/studio-selection-check.mjs test/studio-cdp-startup-check.mjs test/studio-operations-check.mjs test/studio-diagnostics-check.mjs test/studio-repeater-export-check.mjs test/studio-node-capabilities-check.mjs test/studio-gesture-browser-check.mjs test/studio-sync-native-check.mjs test/studio-bundle-merge-check.mjs test/studio-scale-performance-check.mjs test/studio-vector-boolean-check.mjs test/studio-export-code-check.mjs test/studio-benchmark-trials-check.mjs test/studio-merge-scopes-check.mjs test/studio-project-fonts-check.mjs test/studio-runtime-scopes-check.mjs",
    "test:studio-baselines": "python3 benchmarks/studio/validate.py",
    "test:scripted-validate": "node --test test/studio-benchmark-trials-check.mjs",
    "test:attribution": "node tools/check-attribution.mjs",
    "test:forms": "node test/native-form-actions-check.mjs && node test/rp1-native-forms-check.mjs",
    "verify:studio-performance": "node benchmarks/studio/verify-evidence.mjs",
    "test:source-contract": "python3 test/rp-source-contract-check.py",
    "bench:studio-model": "node benchmarks/studio/run-model-trials.mjs",
    "test:studio-finish": "node --test --test-concurrency=1 test/canvas-boost-20261031-check.mjs test/canvas-fix-g7-check.mjs test/canvas-fix-g8-check.mjs test/set-interaction-var-guard-check.mjs test/studio-canvas-g3-fixes-check.mjs test/studio-canvas-g4-fixes-check.mjs test/studio-canvas-g5-fixes-check.mjs test/studio-run-scenario-hit-test-check.mjs test/studio-startup-normalization-check.mjs",
    "test:studio-parity": "node --test test/studio-command-parity-check.mjs",
    "test:layers": "node tools/check-layers.mjs"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.9"
    }
