{
  "name": "zee-rp",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Screenshot reconstruction, RP/1 compilation, and native Axure RP tooling",
  "bin": {
    "zee-rp": "./bin/axure.mjs",
    "zee-rp-mcp": "./bin/mcp.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/regression.mjs",
    "test:native": "node test/native-check.mjs",
    "test:parity": "node test/parity-check.mjs",
    "test:mcp": "node test/mcp-check.mjs",
    "test:historical": "node test/research-regression.mjs",
    "test:historical-mcp": "node test/research-mcp-check.mjs",
    "test:jobs": "node test/jobs-check.mjs",
    "mcp": "node bin/mcp.mjs",
    "test:language": "python3 test/rp-language-check.py",
    "test:sync": "python3 -B test/rp1-merge-residual-check.py",
    "test:runtime": "python3 test/rp-runtime-check.py && python3 test/rp-aggregate-check.py && node test/runtime-native-check.mjs",
    "test:trace": "node scripts/trace.mjs selftest",
    "test:backend": "node test/native-backend-check.mjs",
    "test:visual": "node test/native-visual-check.mjs",
    "test:acceptance": "python3 test/rp-acceptance-check.py && node test/native-acceptance-check.mjs",
    "test:architecture": "python3 test/rp-architecture-upgrades-check.py && python3 test/rp-audit-gaps-check.py && node test/rp-audit-native-check.mjs",
    "pack:source": "node scripts/pack-release.mjs",
    "test:scopes": "node test/scoped-interactions-check.mjs",
    "test:mcp-generate": "node test/mcp-generate-check.mjs",
    "test:authoring": "node test/authoring-workflow-check.mjs",
    "bench:authoring": "node test/authoring-benchmark.mjs",
    "test:trace-recovery": "python3 -B test/trace-recovery-check.py",
    "test:quality": "python3 -B test/creation-quality-check.py && node test/creation-quality-check.mjs",
    "test:report": "python3 -B test/report-regressions-check.py && node test/report-mcp-check.mjs",
    "test:report-round3": "node test/report-round3-check.mjs",
    "test:styles": "node test/custom-styles-check.mjs"
  },
