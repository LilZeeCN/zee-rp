    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "originalEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "phase",
          "originalEvidenceIds",
          "reason",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "relativeTo": {
            "enum": [
              "runDir",
              "sourceRoot",
              "workspaceRoot"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "binding": {
            "$ref": "#/$defs/binding"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "relativeTo",
          "sha256",
          "binding"
        ],
        "additionalProperties": false
