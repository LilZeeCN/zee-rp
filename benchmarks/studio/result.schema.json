          "id",
          "status",
          "evidenceIds",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "agent",
              "user",
              "independent-reviewer"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "reason": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "source",
          "score",
          "reason",
          "evidenceIds"
        ],
