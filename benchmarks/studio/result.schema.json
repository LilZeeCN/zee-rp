                "string",
                "null"
              ]
            },
            "reasoningEffort": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "reasoningEffort",
            "provider"
          ],
          "additionalProperties": false
