    "calls",
    "tokens",
    "evidence",
    "checks",
    "ratings",
    "failures",
    "artifacts",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zee-rp.local/benchmarks/studio/result.schema.json",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "documentId",
        "revision",
        "contentHash"
      ],
      "additionalProperties": false
    }
  }
