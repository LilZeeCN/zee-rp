                "string",
                "null"
              ]
            },
            "hardware": {
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "type": [
                "string",
                "null"
              ]
            },
            "python": {
              "type": [
                "string",
                "null"
              ]
            },
            "axureBuild": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "os",
            "hardware",
            "node",
            "python",
            "axureBuild"
          ],
          "additionalProperties": false
        },
        "briefSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "assetsManifestSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceTreeSha256",
        "sourceManifestPath",
        "toolSchemaSha256",
        "runtimeFingerprint",
        "model",
        "environment",
        "briefSha256",
        "assetsManifestSha256"
