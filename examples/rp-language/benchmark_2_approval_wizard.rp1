rp/1 name="多步立项申请与状态机向导" domain=web theme=enterprise-light statecharts={"ApprovalFlow":{"variable":"flow_state","initial":"草稿","states":["草稿","待审批","已通过"],"transitions":[{"from":"草稿","to":"待审批","on":"submit"},{"from":"待审批","to":"已通过","on":"approve"}]}} invariants=[{"id":"budget_within_limit","expr":"=var.budget >= 0 && var.budget <= 500","message":"立项预算必须在 0 到 500 万之间"}]
var $applicant type=text value="林工"
var $project_name type=text value="AI 原生原型引擎升级"
var $budget type=number value=80
var $flow_state type=text value="草稿"
page #wizard_page [880x560a] name="多步立项申请与状态机向导"
  @column #root_col [880x560] padding=24 gap=14 fill=$bg
    @wizard-card #proj_wizard title="研发立项三步向导" w=832 bodyHeight=280 onComplete=[{"set":{"$flow_state":"待审批","@wiz_tip":"已提交立项申请，等待主管终审"}}]
      :step(root) id=step_basic title="基本信息" nextWhen="=@inp_applicant != '' && @inp_proj != ''" errorMessage="请填写申请人与项目名称" onNext=[{"set":{"$applicant":"=@inp_applicant","$project_name":"=@inp_proj"}}]
        @column #s1_box [760x210] gap=12
          @label #s1_l1 [240x22] "申请人姓名" fontSize=13 fontWeight=600
          @input #inp_applicant [360x36] value="林工"
          @label #s1_l2 [240x22] "立项名称" fontSize=13 fontWeight=600
          @input #inp_proj [360x36] value="AI 原生原型引擎升级"
      :step(root) id=step_budget title="预算核定" nextWhen="=number(@inp_budget) > 0 && number(@inp_budget) <= 500" errorMessage="预算金额必须大于 0 且不超过 500 万元" onNext=[{"set":{"$budget":"=number(@inp_budget)"}}]
        @column #s2_box [760x210] gap=12
          @label #s2_l1 [320x22] "申请预算（万元，上限 500 万）" fontSize=13 fontWeight=600
          @input #inp_budget [240x36] value="80"
          @label #s2_preview [420x24] "='当前核定预算：' + text(var.budget) + ' 万元'" fontSize=12 color=$ink-2
      :step(root) id=step_confirm title="确认提交"
        @column #s3_box [760x210] gap=10
          @detail-card #review_card w=520
            :item id=rv_app label="申请人" value="=var.applicant"
            :item id=rv_proj label="项目名称" value="=var.project_name"
            :item id=rv_bud label="申报预算" value="=text(var.budget) + ' 万元'"
      :slot header
        @row #wiz_custom_header [780x32] gap=12 align=center
          @badge #flow_badge [160x26] "='审批状态：' + var.flow_state"
          @label #wiz_tip [420x24] "每步通过守卫校验后才可进入下一步" fontSize=12 color=$ink-2
      :slot footer
        @row #wiz_custom_footer [780x34] gap=12 align=center
          @button #approve_btn [140x30] "主管一键终审" variant=secondary
            +onClick {"cases":[{"when":"=var.flow_state == '待审批'","do":[{"set":{"$flow_state":"已通过","@wiz_tip":"立项申请已通过主管终审"}}]},{"else":true,"do":[{"set":{"@wiz_tip":"请先完成三步向导并提交审批"}}]}]}
