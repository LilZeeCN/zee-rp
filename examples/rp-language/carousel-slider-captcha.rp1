rp/1 target=9 name="同步轮播与有界滑块拼图验证" domain=web theme=enterprise-light
page #demo name="轮播与滑块验证" canvas=[440,620]
  +onLoad [{"type":"set-panel-state","target":"banner","mode":"next","loop":true,"repeatInterval":3000,"repeatSkipFirst":true,"enterAnimation":"slideLeft","enterDuration":120}]
  box #root [440x620] layout=stack fill=#F8FAFC
    label #title [360x28] x=40 y=16 "动态面板轮播 + 有界滑块拼图" fontSize=16 fontWeight=700 color=#0F172A
    dynamic-panel #banner [360x160] x=40 y=52
      +onSwipeLeft [{"type":"set-panel-state","target":"banner","mode":"next","loop":true,"repeatInterval":3000,"repeatSkipFirst":false,"enterAnimation":"slideLeft","enterDuration":120}]
      +onSwipeRight [{"type":"set-panel-state","target":"banner","mode":"previous","loop":true,"repeatInterval":3000,"repeatSkipFirst":false,"enterAnimation":"slideRight","enterDuration":120}]
      +onStateChange {"cases":[{"when":"=@banner.state == 's1'","actions":[{"type":"set-panel-state","target":"indicator","state":"s1"}]},{"when":"=@banner.state == 's2'","actions":[{"type":"set-panel-state","target":"indicator","state":"s2"}]},{"when":"=@banner.state == 's3'","actions":[{"type":"set-panel-state","target":"indicator","state":"s3"}]},{"else":true,"actions":[{"type":"set-panel-state","target":"indicator","state":"s4"}]}]}
      :state s1
        box #c1 [360x160] layout=stack fill=#DBEAFE radius=12
          label #l1 [320x36] x=20 y=62 "幻灯片 1 / 4 · 向左滑动或等待 3 秒自动切换" color=#1E3A8A align=center
      :state s2
        box #c2 [360x160] layout=stack fill=#EDE9FE radius=12
          label #l2 [320x36] x=20 y=62 "幻灯片 2 / 4 · 指示器已同步" color=#4C1D95 align=center
      :state s3
        box #c3 [360x160] layout=stack fill=#DCFCE7 radius=12
          label #l3 [320x36] x=20 y=62 "幻灯片 3 / 4 · 自动恢复 3s 轮播" color=#14532D align=center
      :state s4
        box #c4 [360x160] layout=stack fill=#FEF3C7 radius=12
          label #l4 [320x36] x=20 y=62 "幻灯片 4 / 4 · 循环轮播" color=#78350F align=center
    label #banner_state [200x24] x=40 y=222 "当前幻灯片：${@banner.state}" fontSize=13 color=#334155
    dynamic-panel #indicator [100x24] x=300 y=222
      :state s1
        box #ind1 [100x24] layout=stack fill=#2563EB radius=12
          label #it1 [100x24] x=0 y=3 "1 / 4" fontSize=12 color=#FFFFFF align=center
      :state s2
        box #ind2 [100x24] layout=stack fill=#7C3AED radius=12
          label #it2 [100x24] x=0 y=3 "2 / 4" fontSize=12 color=#FFFFFF align=center
      :state s3
        box #ind3 [100x24] layout=stack fill=#16A34A radius=12
          label #it3 [100x24] x=0 y=3 "3 / 4" fontSize=12 color=#FFFFFF align=center
      :state s4
        box #ind4 [100x24] layout=stack fill=#D97706 radius=12
          label #it4 [100x24] x=0 y=3 "4 / 4" fontSize=12 color=#FFFFFF align=center
    box #scene [360x140] x=40 y=264 layout=stack fill=#E2E8F0 radius=12
    box #target [48x48] x=220 y=310 layout=stack fill=#334155 radius=6
      label #target_lbl [48x48] x=0 y=14 "目标" fontSize=11 color=#F8FAFC align=center
    dynamic-panel #piece [48x48] x=40 y=310
      :state idle
        box #piece_box [48x48] layout=stack fill=#4F46E5 radius=6
          label #piece_lbl [48x48] x=0 y=14 "拼图" fontSize=11 color=#FFFFFF align=center
    box #track [360x44] x=40 y=424 layout=stack fill=#CBD5E1 stroke=#94A3B8 radius=22
      label #track_hint [260x24] x=70 y=10 "向右拖动滑块对齐目标（±2px 自动吸附）" fontSize=12 color=#475569
    dynamic-panel #thumb [60x44] x=40 y=424
      +onDrag [{"type":"move","target":"thumb","mode":"drag-x","bounds":{"within":"track"}},{"type":"move","target":"piece","mode":"location","x":"=@thumb.x","duration":0}]
      +onDragDrop {"cases":[{"when":"=@piece.x >= @target.x - 2 && @piece.x <= @target.x + 2","actions":[{"type":"move","target":"piece","mode":"location","x":"=@target.x","duration":0},{"type":"move","target":"thumb","mode":"location","x":"=@target.x","duration":0},{"type":"set-text","target":"captcha_status","text":"验证成功"}]},{"else":true,"actions":[{"type":"move","target":"thumb","mode":"locationBeforeDrag","duration":0},{"type":"move","target":"piece","mode":"location","x":40,"duration":0},{"type":"set-text","target":"captcha_status","text":"验证失败"}]}]}
      :state ready
        box #thumb_box [60x44] layout=stack fill=#4F46E5 radius=22
          label #thumb_lbl [60x44] x=0 y=11 ">>>" fontSize=14 fontWeight=700 color=#FFFFFF align=center
    label #captcha_status [220x28] x=40 y=486 "待验证" fontSize=14 fontWeight=600 color=#0F172A
    button #check_overlap [130x32] x=270 y=484 "检查重叠"
      +onClick {"cases":[{"when":"=isOver(@piece, @target)","actions":[{"type":"set-text","target":"overlap_status","text":"已重叠"}]},{"else":true,"actions":[{"type":"set-text","target":"overlap_status","text":"未重叠"}]}]}
    label #overlap_status [130x24] x=270 y=522 "未重叠" fontSize=12 color=#64748B
