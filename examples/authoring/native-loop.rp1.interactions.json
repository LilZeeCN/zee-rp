{
  "program": {
    "page": "loop",
    "on": {
      "evaluate": {
        "click": [
          {
            "set": {
              "$factor": "=number(@base)",
              "$product": 1
            }
          },
          {
            "repeat": "=number(@count)",
            "limit": 32,
            "do": [
              {
                "set": {
                  "$product": "=$product * $factor"
                }
              }
            ],
            "else": [
              {
                "set": {
                  "@out": "次数须在 0–32 之间"
                }
              }
            ],
            "then": [
              {
                "set": {
                  "@out": "=text($product)"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "action": "fill",
      "target": "loop/base",
      "value": "99"
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "3"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "970299"
      }
    },
    {
      "action": "fill",
      "target": "loop/base",
      "value": "2"
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "5"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "32"
      }
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "33"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "次数须在 0–32 之间"
      }
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "2.5"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "次数须在 0–32 之间"
      }
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "0"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "1"
      }
    },
    {
      "action": "fill",
      "target": "loop/count",
      "value": "32"
    },
    {
      "action": "click",
      "target": "loop/evaluate"
    },
    {
      "action": "expect",
      "target": "loop/out",
      "expect": {
        "text": "4294967296"
      }
    }
  ]
}
