{
  "program": {
    "page": "form",
    "routines": {
      "validate": [
        {
          "if": "@first == ''",
          "then": [
            {
              "set": {
                "@feedback": "请填写通行短语"
              }
            }
          ],
          "else": [
            {
              "if": "@second == ''",
              "then": [
                {
                  "set": {
                    "@feedback": "请确认通行短语"
                  }
                }
              ],
              "else": [
                {
                  "if": "@first != @second",
                  "then": [
                    {
                      "set": {
                        "@feedback": "两次输入不一致"
                      }
                    }
                  ],
                  "else": [
                    {
                      "set": {
                        "@feedback": "校验通过"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "on": {
      "first": {
        "blur": [
          {
            "call": "validate"
          }
        ]
      },
      "second": {
        "blur": [
          {
            "call": "validate"
          }
        ]
      },
      "submit": {
        "click": [
          {
            "call": "validate"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "action": "click",
      "target": "form/submit"
    },
    {
      "action": "expect",
      "target": "form/feedback",
      "expect": {
        "text": "请填写通行短语"
      }
    },
    {
      "action": "fill",
      "target": "form/first",
      "value": "学习计划"
    },
    {
      "action": "expect",
      "target": "form/feedback",
      "expect": {
        "text": "请确认通行短语"
      }
    },
    {
      "action": "fill",
      "target": "form/second",
      "value": "错误示例"
    },
    {
      "action": "expect",
      "target": "form/feedback",
      "expect": {
        "text": "两次输入不一致"
      }
    },
    {
      "action": "fill",
      "target": "form/second",
      "value": "学习计划"
    },
    {
      "action": "expect",
      "target": "form/feedback",
      "expect": {
        "text": "校验通过"
      }
    },
    {
      "action": "click",
      "target": "form/submit"
    },
    {
      "action": "expect",
      "target": "form/feedback",
      "expect": {
        "text": "校验通过"
      }
    }
  ]
}
