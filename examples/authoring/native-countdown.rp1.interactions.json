{
  "program": {
    "page": "timer",
    "on": {
      "start": {
        "click": [
          {
            "type": "set-panel-state",
            "target": "clock",
            "mode": "current"
          },
          {
            "set": {
              "$running": 1,
              "$left_ms": 1500,
              "$deadline": "=nowMs() + 1500",
              "@remaining": "1500",
              "@status": "运行中"
            }
          },
          {
            "type": "set-panel-state",
            "target": "clock",
            "mode": "next",
            "loop": true,
            "repeatInterval": 250,
            "repeatSkipFirst": true
          }
        ]
      },
      "stop": {
        "click": [
          {
            "set": {
              "$running": 0,
              "@status": "已停止"
            }
          },
          {
            "type": "set-panel-state",
            "target": "clock",
            "mode": "current"
          }
        ]
      },
      "clock": {
        "statechange": [
          {
            "if": "$running == 1",
            "then": [
              {
                "set": {
                  "$left_ms": "=$deadline - nowMs()"
                }
              },
              {
                "if": "$left_ms <= 0",
                "then": [
                  {
                    "set": {
                      "$running": 0,
                      "$left_ms": 0,
                      "@remaining": "0",
                      "@status": "已到期"
                    }
                  },
                  {
                    "type": "set-panel-state",
                    "target": "clock",
                    "mode": "current"
                  }
                ],
                "else": [
                  {
                    "set": {
                      "@remaining": "=text($left_ms)"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "action": "expect",
      "target": "timer/remaining",
      "expect": {
        "text": "1500"
      }
    },
    {
      "action": "click",
      "target": "timer/start"
    },
    {
      "action": "expect",
      "target": "timer/status",
      "expect": {
        "text": "运行中"
      }
    },
    {
      "action": "advanceTime",
      "ms": 250
    },
    {
      "action": "expect",
      "target": "timer/remaining",
      "expect": {
        "text": "1250"
      }
    },
    {
      "action": "click",
      "target": "timer/stop"
    },
    {
      "action": "advanceTime",
      "ms": 1750
    },
    {
      "action": "expect",
      "target": "timer/remaining",
      "expect": {
        "text": "1250"
      }
    },
    {
      "action": "expect",
      "target": "timer/status",
      "expect": {
        "text": "已停止"
      }
    },
    {
      "action": "click",
      "target": "timer/start"
    },
    {
      "action": "advanceTime",
      "ms": 1250
    },
    {
      "action": "expect",
      "target": "timer/remaining",
      "expect": {
        "text": "250"
      }
    },
    {
      "action": "advanceTime",
      "ms": 250
    },
    {
      "action": "expect",
      "target": "timer/status",
      "expect": {
        "text": "已到期"
      }
    },
    {
      "action": "expect",
      "target": "timer/remaining",
      "expect": {
        "text": "0"
      }
    }
  ]
}
