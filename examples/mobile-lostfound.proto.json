{
  "name": "拾物 · 校园失物招领 App 原型",
  "domain": "mobile",
  "theme": "mobile-lowfi",
  "pages": [
    {
      "name": "页面一：失物信息浏览页",
      "slug": "page1-browse",
      "device": "iphone-x",
      "canvas": {
        "w": 375,
        "h": 812
      },
      "root": {
        "type": "box",
        "name": "grp-p1-screen",
        "layout": "column",
        "w": 375,
        "h": 812,
        "padding": [
          44,
          0,
          0,
          0
        ],
        "gap": 0,
        "fill": "$bg",
        "isGroup": true,
        "bgName": "bg-p1-screen",
        "children": [
          {
            "type": "mobile-navbar",
            "prefix": "p1",
            "title": "拾物 · 招领广场",
            "rightText": "规范说明",
            "rightName": "p1-btn-doc"
          },
          {
            "type": "mobile-searchbar",
            "prefix": "p1"
          },
          {
            "type": "mobile-segmented",
            "prefix": "p1"
          },
          {
            "type": "mobile-card-list",
            "prefix": "p1",
            "h": 548,
            "bindDetail": {
              "page": "页面二：物品详情页",
              "panel": "panel-item-state"
            }
          },
          {
            "type": "mobile-tabbar",
            "prefix": "p1"
          }
        ]
      },
      "interactions": [
        {
          "trigger": "p1-btn-detail-c1",
          "description": "点击卡片1进入物品详情页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoDetail1",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面二：物品详情页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "p1-btn-detail-c2",
          "description": "点击卡片2进入物品详情页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoDetail2",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面二：物品详情页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "p1-btn-detail-c3",
          "description": "点击卡片3进入物品详情页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoDetail3",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面二：物品详情页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "p1-btn-detail-c4",
          "description": "点击卡片4进入物品详情页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoDetail4",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面二：物品详情页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "p1-btn-publish-plus",
          "description": "点击底部发布按钮进入物品详情/发布页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoPublish",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面二：物品详情页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "p1-btn-doc",
          "description": "点击右上角规范说明进入设计说明页",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "GoDoc",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面三：页面关系与设计说明"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "页面二：物品详情页",
      "slug": "page2-detail-panel",
      "device": null,
      "canvas": {
        "w": 420,
        "h": 860
      },
      "root": {
        "type": "box",
        "name": "grp-p2-host",
        "layout": "stack",
        "w": 420,
        "h": 860,
        "fill": "$surface",
        "isGroup": true,
        "bgName": "bg-p2-host",
        "children": [
          {
            "type": "dynamic-panel",
            "name": "panel-item-state",
            "x": 0,
            "y": 0,
            "w": 420,
            "h": 860,
            "states": [
              {
                "name": "状态一：查看物品详情",
                "prefix": "view",
                "device": "iphone-x",
                "canvas": {
                  "w": 375,
                  "h": 812
                },
                "root": {
                  "type": "mobile-detail-view",
                  "prefix": "view",
                  "title": "物品信息详情"
                }
              },
              {
                "name": "状态二：发布失物招领",
                "prefix": "pub",
                "device": "iphone-x",
                "canvas": {
                  "w": 375,
                  "h": 812
                },
                "root": {
                  "type": "mobile-form-view",
                  "prefix": "pub",
                  "title": "发布寻物 / 招领信息"
                }
              }
            ]
          }
        ]
      },
      "interactions": [
        {
          "trigger": "view-btn-to-publish",
          "description": "从查看态切换到发布态",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "ToPublishState",
                  "actions": [
                    {
                      "type": "set-panel-state",
                      "target": "panel-item-state",
                      "state": "状态二：发布失物招领"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "view-btn-back",
          "description": "从详情查看态返回招领广场",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "BackToSquareFromView",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面一：失物信息浏览页"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "pub-btn-to-view",
          "description": "从发布态切换回查看态",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "ToViewState",
                  "actions": [
                    {
                      "type": "set-panel-state",
                      "target": "panel-item-state",
                      "state": "状态一：查看物品详情"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "pub-btn-back",
          "description": "从发布态返回查看态",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "BackToViewFromPub",
                  "actions": [
                    {
                      "type": "set-panel-state",
                      "target": "panel-item-state",
                      "state": "状态一：查看物品详情"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "trigger": "pub-btn-submit",
          "description": "提交发布后返回招领广场",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "SubmitAndBackSquare",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面一：失物信息浏览页"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "页面三：页面关系与设计说明",
      "slug": "page3-spec-doc",
      "device": null,
      "canvas": {
        "w": 1120,
        "h": 680
      },
      "root": {
        "type": "box",
        "name": "grp-doc-canvas",
        "layout": "column",
        "w": 1120,
        "h": 680,
        "padding": [
          28,
          32
        ],
        "gap": 20,
        "fill": "$bg",
        "isGroup": true,
        "bgName": "bg-doc-canvas",
        "children": [
          {
            "type": "box",
            "name": "grp-doc-header",
            "layout": "row",
            "w": 1056,
            "h": 72,
            "padding": [
              16,
              20
            ],
            "gap": 16,
            "align": "center",
            "fill": "$surface",
            "stroke": "$line",
            "radius": 10,
            "isGroup": true,
            "bgName": "bg-doc-header",
            "children": [
              {
                "type": "box",
                "name": "grp-doc-title-col",
                "layout": "column",
                "flex": 1,
                "gap": 4,
                "isGroup": true,
                "children": [
                  {
                    "type": "label",
                    "name": "doc-main-title",
                    "text": "拾物 · 校园失物招领 App — 页面流转与设计规范说明",
                    "fontSize": 18,
                    "fontWeight": 700,
                    "color": "$ink",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-main-sub",
                    "text": "遵循 iPhone X (375×812 pt / 420×860 整机画板) 低保真灰阶线框规范 · 全元件语义命名与编组",
                    "fontSize": 12,
                    "fontWeight": 400,
                    "color": "$ink-2",
                    "align": "left"
                  }
                ]
              },
              {
                "type": "shape-text",
                "name": "doc-btn-back-app",
                "text": "返回招领广场 >",
                "w": 132,
                "h": 36,
                "fill": "$brand",
                "stroke": null,
                "color": "$ink-inv",
                "fontSize": 12,
                "fontWeight": 600,
                "radius": 8,
                "align": "center"
              }
            ]
          },
          {
            "type": "box",
            "name": "grp-doc-cards",
            "layout": "row",
            "w": 1056,
            "h": 520,
            "gap": 20,
            "isGroup": true,
            "children": [
              {
                "type": "box",
                "name": "grp-doc-col-1",
                "layout": "column",
                "flex": 1,
                "h": 520,
                "padding": [
                  20,
                  20
                ],
                "gap": 12,
                "fill": "$surface",
                "stroke": "$line",
                "radius": 10,
                "isGroup": true,
                "bgName": "bg-doc-col-1",
                "children": [
                  {
                    "type": "shape-text",
                    "name": "doc-tag-1",
                    "text": "01 · 页面架构与跳转关系",
                    "w": 188,
                    "h": 26,
                    "fill": "$surface-2",
                    "stroke": "$line-strong",
                    "color": "$ink",
                    "fontSize": 11,
                    "fontWeight": 500,
                    "radius": 6,
                    "align": "center"
                  },
                  {
                    "type": "paragraph",
                    "name": "doc-para-flow",
                    "w": 292,
                    "fontSize": 12,
                    "text": "本原型包含 3 个顶层页面：页面一为失物信息浏览广场；页面二内置双状态动态面板（状态一：查看物品详情；状态二：发布寻物/招领信息）；页面三为本架构与设计规范说明。"
                  },
                  {
                    "type": "label",
                    "name": "doc-flow-rule-1",
                    "text": "1. 浏览页点击任意物品卡片 → 跳转页面二（查看态）",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-flow-rule-2",
                    "text": "2. 详情查看态点击右上角「去发布」→ 切换至发布态",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-flow-rule-3",
                    "text": "3. 发布态点击「确认发布」→ 返回页面一招领广场",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  }
                ]
              },
              {
                "type": "box",
                "name": "grp-doc-col-2",
                "layout": "column",
                "flex": 1,
                "h": 520,
                "padding": [
                  20,
                  20
                ],
                "gap": 12,
                "fill": "$surface",
                "stroke": "$line",
                "radius": 10,
                "isGroup": true,
                "bgName": "bg-doc-col-2",
                "children": [
                  {
                    "type": "shape-text",
                    "name": "doc-tag-2",
                    "text": "02 · 视口尺寸与安全区规范",
                    "w": 188,
                    "h": 26,
                    "fill": "$surface-2",
                    "stroke": "$line-strong",
                    "color": "$ink",
                    "fontSize": 11,
                    "fontWeight": 500,
                    "radius": 6,
                    "align": "center"
                  },
                  {
                    "type": "paragraph",
                    "name": "doc-para-spec",
                    "w": 292,
                    "fontSize": 12,
                    "text": "采用内置 iPhone X 规范外框（外框 420×860 px，内屏视口 375×812 px，内屏偏移 X=25, Y=21）。顶部预留 44pt 状态栏与 44pt 导航栏，底部预留 34pt Home Indicator 安全区。"
                  },
                  {
                    "type": "label",
                    "name": "doc-spec-item-1",
                    "text": "• 页面边距：左右安全间距 16pt，卡片内边距 12pt",
                    "fontSize": 12,
                    "fontWeight": 500,
                    "color": "$ink-2",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-spec-item-2",
                    "text": "• 色彩体系：纯灰阶低保真线框（#262626 ~ #F7F7F7）",
                    "fontSize": 12,
                    "fontWeight": 500,
                    "color": "$ink-2",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-spec-item-3",
                    "text": "• 字阶规范：标题 16/18pt，正文 12/13pt，辅助 11pt",
                    "fontSize": 12,
                    "fontWeight": 500,
                    "color": "$ink-2",
                    "align": "left"
                  }
                ]
              },
              {
                "type": "box",
                "name": "grp-doc-col-3",
                "layout": "column",
                "flex": 1,
                "h": 520,
                "padding": [
                  20,
                  20
                ],
                "gap": 12,
                "fill": "$surface",
                "stroke": "$line",
                "radius": 10,
                "isGroup": true,
                "bgName": "bg-doc-col-3",
                "children": [
                  {
                    "type": "shape-text",
                    "name": "doc-tag-3",
                    "text": "03 · 结构与命名质量门禁",
                    "w": 188,
                    "h": 26,
                    "fill": "$surface-2",
                    "stroke": "$line-strong",
                    "color": "$ink",
                    "fontSize": 11,
                    "fontWeight": 500,
                    "radius": 6,
                    "align": "center"
                  },
                  {
                    "type": "paragraph",
                    "name": "doc-para-qa",
                    "w": 292,
                    "fontSize": 12,
                    "text": "所有页面与动态面板状态均通过确定性 Auto-Layout 排版、PingFang 字宽防裁切校验、原生 Layer 编组发射与 0 重名全量坐标校验。"
                  },
                  {
                    "type": "label",
                    "name": "doc-qa-item-1",
                    "text": "● 语义命名覆盖率：100%（零 Unnamed / 零重名）",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-qa-item-2",
                    "text": "● 原生 Layer 编组覆盖率：≥ 95%",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  },
                  {
                    "type": "label",
                    "name": "doc-qa-item-3",
                    "text": "● 文本裁切与重叠数：0 处",
                    "fontSize": 12,
                    "fontWeight": 600,
                    "color": "$ink",
                    "align": "left"
                  }
                ]
              }
            ]
          }
        ]
      },
      "interactions": [
        {
          "trigger": "doc-btn-back-app",
          "description": "从说明页返回招领广场",
          "events": [
            {
              "event": "OnClick",
              "cases": [
                {
                  "name": "BackToSquareFromDoc",
                  "actions": [
                    {
                      "type": "link",
                      "page": "页面一：失物信息浏览页"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}