        {
          "action": "click",
          "target": "close_record",
          "expect": {
            "visible": {
              "record_detail": false
            }
          }
        },
        {
          "action": "click",
          "target": "reset_filter",
          "expect": {
            "visible": {
              "all_records": true,
              "available_records": false
            },
            "text": {
              "count_label": "8 RECORDS"
            }
          }
        }
      ]
