  "name": "岸线 · 图文观察手记",
  "intent": "editorial",
  "platform": "web",
  "pages": [
    {
      "id": "shore",
      "name": "岸线 · 观察手记"
    },
    {
      "id": "field_note",
      "name": "一束蓝色的停顿"
    }
  ],
  "initialPageId": "shore",
  "scenarios": [
    {
      "id": "read-save-cancel-return",
      "startPageId": "shore",
      "steps": [
        {
          "expect": {
            "page": "shore",
            "visible": {
              "cover_title": true
            }
          }
        },
        {
          "action": "click",
          "target": "read_story",
          "expect": {
            "page": "field_note",
            "visible": {
              "body_paragraph_2": true,
              "save_story": true,
              "saved_note": false
            }
          }
        },
        {
          "action": "click",
          "target": "save_story",
          "expect": {
            "visible": {
              "unsave_story": true,
              "save_story": false,
              "saved_note": true
            }
          }
        },
        {
          "action": "click",
          "target": "unsave_story",
          "expect": {
            "visible": {
              "save_story": true,
              "unsave_story": false,
              "saved_note": false
            }
          }
        },
        {
          "action": "click",
          "target": "back_bottom",
          "expect": {
            "page": "shore",
            "visible": {
              "cover_title": true
            }
          }
        }
      ]
    },
    {
      "id": "top-return",
      "startPageId": "shore",
      "steps": [
        {
          "action": "click",
          "target": "read_story",
          "expect": {
            "page": "field_note"
          }
        },
        {
          "action": "click",
          "target": "back_top",
          "expect": {
            "page": "shore"
          }
        }
      ]
    }
  ],
  "design": {
    "protagonist": "首页由大幅翠鸟照片与两行标题共同领衔；详情页由连续阅读正文主导",
    "readingOrder": [
      "刊名与期号",
