                "fontFamily": "PingFang SC",
                "fill": "#87472E",
                "fontWeight": 600,
                "textAlign": "center",
                "role": "primary-action",
                "on": {
                  "click": {
                    "cases": [
                      {
                        "when": "=@visitor_name == ''",
                        "actions": [
                          {
                            "type": "set-text",
                            "target": "form_error",
                            "text": "请填写姓名后再登记。"
                          },
                          {
                            "type": "show",
                            "target": "form_error"
                          }
                        ]
                      },
                      {
                        "when": "=@visit_purpose == ''",
                        "actions": [
                          {
                            "type": "set-text",
                            "target": "form_error",
                            "text": "请填写使用目的，方便准备观察席。"
                          },
                          {
                            "type": "show",
                            "target": "form_error"
                          }
                        ]
                      },
                      {
                        "else": true,
                        "actions": [
                          {
                            "type": "hide",
                            "target": "form_error"
                          },
                          {
                            "type": "set-text",
                            "target": "confirmed_name",
                            "text": "=@visitor_name"
                          },
                          {
                            "type": "set-text",
                            "target": "confirmed_purpose",
                            "text": "=@visit_purpose"
                          },
                          {
                            "type": "hide",
                            "target": "booking_form"
                          },
                          {
                            "type": "show",
                            "target": "booking_success"
                          }
                        ]
                      }
                    ]
                  }
                }
