    "materials": "暖灰底、铜色动作面、连续细分隔和等宽日期读数；不使用照片和同权重卡片网格。",
    "directions": [
      {
        "name": "连续登记",
        "structure": "左侧连续填写，右侧固定时段概览；错误出现在提交附近并保留字段。",
        "difference": "同页完成与核对。"
      },
      {
        "name": "逐步办理",
        "structure": "第一屏先选日期，第二屏填写使用人，第三屏确认；允许返回前一步保留值。",
        "difference": "将工作拆成有顺序的三步。"
      },
      {
        "name": "时段工作台",
        "structure": "以周历和时段列表为主区，选中时段后打开窄侧栏填写；成功后回到原周历。",
        "difference": "从时间资源分配进入，表单成为次级区域。"
      }
    ],
    "limitations": [
      "这是本地交互参考，不连接真实预约服务，也不检测时段冲突。",
      "验证两个必填字段为空的错误分支，不承诺姓名合法性或任意长度规则。",
      "输入值在本次运行的返回修改中保留；持久业务记录需要另接数据源。",
      "原生输入框字体受当前 RP 出口边界约束，见兼容报告。"
    ]
  },
