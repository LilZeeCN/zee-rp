  "initialPageId": "booking",
  "scenarios": [
    {
      "id": "booking-errors-and-success",
      "startPageId": "booking",
      "steps": [
        {
          "expect": {
            "page": "booking",
            "visible": {
              "booking_form": true,
              "booking_success": false,
              "form_error": false
            }
          }
        },
        {
          "action": "click",
          "target": "submit_booking",
          "expect": {
            "visible": {
              "form_error": true
            },
            "text": {
              "form_error": "请填写姓名后再登记。"
            }
          }
        },
        {
          "action": "input",
          "target": "visitor_name",
          "value": "林知夏",
          "expect": {
            "text": {
              "visitor_name": "林知夏"
            }
          }
        },
        {
          "action": "click",
          "target": "submit_booking",
          "expect": {
            "text": {
              "form_error": "请填写使用目的，方便准备观察席。"
            }
          }
        },
        {
          "action": "input",
          "target": "visit_purpose",
          "value": "观察纸张在侧光下的纤维纹理，并记录三种纸张的触感差异。",
          "expect": {
            "text": {
              "visit_purpose": {
                "includes": "纤维纹理"
              }
            }
          }
        },
        {
          "action": "click",
          "target": "submit_booking",
          "expect": {
            "visible": {
              "booking_success": true,
              "booking_form": false
            },
            "text": {
              "confirmed_name": "林知夏",
              "confirmed_purpose": {
                "includes": "纤维纹理"
              }
            }
          }
        },
        {
          "action": "click",
          "target": "edit_booking",
          "expect": {
            "visible": {
              "booking_form": true,
              "booking_success": false
            },
            "text": {
              "visitor_name": "林知夏"
            }
          }
        }
      ]
    }
  ],
